Content/City_of_Brass_Enviroment/
Content/AdvancedLocomotionV4/
Content/StarterContent/
Content/MetaHumans/
Content/Characters/

# Copies of marketplace assets used by Mazzarino80
Content/Mazzarino80/Library/

# Level backups / recovery snapshots
Content/Mazzarino80/PCG/Backups/
Content/Levels/M80_Recovery_*

# Blender generated output (rebuildable from Pipeline/Blender scripts)
Pipeline/Blender/output/

# PCG QA / validation maps (disposable)
Content/Mazzarino80/PCG/Validation/*.umap
Content/Mazzarino80/PCG/DetailMaterialCandidate_v1/*.umap

# Derived house data, regenerated by Scripts/m80_houses_district.py and the bake step
Content/Mazzarino80/Houses/Maps/L_M80_District_*
Content/Mazzarino80/Houses/Baked/

# Marketplace / Epic template packs pulled in by the cars migrated from Comune (re-downloadable)
Content/VehicleVarietyVol2/
Content/FPWeapon/
Content/FirstPerson/
Content/FirstPersonArms/

# Ape skeletal mesh (324 MB): too big for the LFS quota, kept only locally and in the MTGBackup copies
Content/Drive/ApeCar/ApeDrivable.uasset

# Archive of the previous repository history (kept locally only)
.git_old/

# Palazzo Bartoli texture sources generated by the Blender scripts (m80_bartoli_texture.py, m80_bartoli_gioco.py):
# regenerable, the imported textures are in Content
Research/Mazzarino80/Blender/Textures/Bartoli/
Research/Mazzarino80/Blender/Textures/BartoliGioco/
